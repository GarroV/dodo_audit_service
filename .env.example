# Пример конфигурации. Скопировать в .env и заполнить значения.
# Настоящий .env в git не попадает.

# Токен бота от @BotFather. У каждого продукта свой: Telegram отдаёт
# обновления только одному получателю, второй молча выбивает первого.
TELEGRAM_BOT_TOKEN=

# Ключ OpenAI: разбор комментариев и транскрипция голосовых.
OPENAI_API_KEY=

# Каталог с методикой: чек-лист, зоны, критерии, ставки вычетов.
# Держится вне репозитория — это данные управляющей компании.
AUDIT_DATA_DIR=./data

# Где лежат файлы состояния проверок (папка на чат).
STATE_DIR=./.state

# --- демо-стенд (профиль `demo` в docker-compose.yml, задача T102) -----------
#
# Демо настраивается ТЕМ ЖЕ механизмом и из ТОГО ЖЕ файла, что боевой стенд
# (решение D059) — отдельного набора переменных где-то ещё нет. Ниже только
# то, что обязано отличаться; всё остальное (OPENAI_API_KEY, TZ, RECOGNIZE_*,
# AUDITOR_NAMES) демо берёт отсюда же, без дублей.

# Где лежит состояние демо. `make demo` и сид пишут сюда, а НЕ в STATE_DIR:
# на сервере STATE_DIR указывает на настоящие проверки, и демо-отчёт лёг бы в
# одну папку с отчётами партнёрам. Пусто — demo/state в репозитории.
# Демо-стенд в контейнере ставит сюда свой том.
DEMO_STATE_DIR=

# Токен ВТОРОГО бота от @BotFather — для демо. Один токен на два бота не
# делится: Telegram отдаёт обновления одному получателю, второй молча выбивает
# первого. Пусто — демо-бот откажется стартовать; это лучше, чем демо,
# случайно поднятое на боевом токене.
DEMO_TELEGRAM_BOT_TOKEN=

# Кому разрешён демо-бот. Telegram ID через запятую, свой список — тем, кому
# показываем; боевой список сюда не копируется.
DEMO_ALLOWED_TELEGRAM_IDS=

# База демо. Пусто — демо не пишет в базу вовсе. Боевую строку подключения
# сюда не ставить ни при каких обстоятельствах: демо не трогает боевые данные.
DEMO_DATABASE_URL=

# Кому разрешено пользоваться ботом. Telegram ID через запятую.
ALLOWED_TELEGRAM_IDS=

# Имя проверяющего для шапки отчёта по его Telegram ID: «ID:Имя Фамилия» через
# запятую. Необязательна — без неё имя берётся из профиля Telegram.
AUDITOR_NAMES=

# Куда сливаются завершённые проверки (D027). Строка подключения Postgres
# целиком — площадка вынесена в неё саму и больше никуда: переезд в Supabase
# позже будет стоить правки этой одной строки, без единой правки кода (D061).
# Пример для своего Postgres на машине: postgresql://user@127.0.0.1:5432/dodo_audit_service
# Пример для базы из профиля `db` ниже, с хоста: postgresql://dodo_audit:ПАРОЛЬ@127.0.0.1:5432/dodo_audit_service
# Она же изнутри контейнера бота: postgresql://dodo_audit:ПАРОЛЬ@db:5432/dodo_audit_service
DATABASE_URL=

# Роль, под которой ходит приложение, и роль, под которой катятся миграции —
# РАЗНЫЕ, и это не аккуратность (задача T111). Запрет правки завершённой
# проверки держится построчными политиками, а суперпользователь Postgres
# обходит их ВСЕГДА. Приложение под привилегированной ролью выглядело бы
# защищённым, ничем таковым не являясь; раннер миграций предупреждает об этом
# вслух при накате.
#
# DATABASE_ADMIN_URL — подключение с правом заводить роли и накатывать схему.
# Пусто — миграции идут под DATABASE_URL, и предупреждение вы увидите.
DATABASE_ADMIN_URL=
# DATABASE_APP_PASSWORD — пароль роли приложения `dodo_audit_app`. Задать при
# первом накате; пустая строка отвергается отказом, потому что пустой пароль
# оставил бы роль без входа молча. Убрать переменную совсем — пароль не
# трогается.
DATABASE_APP_PASSWORD=

# --- Postgres рядом с ботом (профиль `db` в docker-compose.yml, задача T090) -
#
# Нужны только тому, кто поднимает базу этим же compose (`make db-up`). Если
# DATABASE_URL выше указывает на уже существующий Postgres, профиль `db` не
# поднимается и переменные ниже не читаются вовсе.

# Имя базы и роль внутри контейнера. DATABASE_URL обязан совпадать с ними.
POSTGRES_DB=dodo_audit_service
POSTGRES_USER=dodo_audit

# Пароль роли. Пусто — контейнер откажется стартовать с внятным сообщением;
# это лучше, чем база проверок партнёров, поднятая без пароля.
POSTGRES_PASSWORD=

# Порт базы на хосте. Наружу он не смотрит — только на петлю (127.0.0.1), см.
# docker-compose.yml. Менять здесь приходится в двух случаях: на машине уже
# занят 5432 своим Postgres, и параллельные рабочие копии обязаны расходиться
# по портам. Изменил порт — поменяй и DATABASE_URL выше.
POSTGRES_PORT=5432

# --- MCP-сервер поверх базы проверок (задача T095, решение D055) -------------
#
# Сервер даёт спрашивать накопленные проверки через Claude. Проверки — только
# на чтение: записать проверку через него нельзя ничем. Правка методики
# (чек-листа) — отдельная настройка ниже, и по умолчанию она выключена.
#
# КТО СПРАШИВАЕТ, ТОТ И ОПРЕДЕЛЯЕТ, ЧЬИ ПРОВЕРКИ ВИДНЫ. Код арендатора берётся
# из токена и ниоткуда больше: аргументом вызова его назвал бы кто угодно, и
# агент партнёра прочитал бы историю соседа. Формат — «арендатор=токен» через
# запятую или с новой строки; у одного арендатора может быть несколько токенов
# (по человеку на токен), один токен на двух арендаторов — отказ на старте.
#
# Токен генерируется случайным и длинным, например:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Пусто — сервер не поднимется: открытый сервер хуже не поднявшегося.
MCP_TOKENS=

# Адрес и порт, на которых слушает сервер. Только петля: площадка общая, и
# порт, открытый в сеть, отдал бы проверки партнёров соседям по машине —
# адрес вне петли сервер не примет. Пусто — 127.0.0.1 и 8265.
MCP_HOST=
MCP_PORT=

# --- правка методики через агента (задача T098, решения D049 и D050) ---------
#
# ЭТО ЕДИНСТВЕННОЕ МЕСТО, ГДЕ MCP ПЕРЕСТАЁТ БЫТЬ ТОЛЬКО ЧТЕНИЕМ. За этими
# двумя переменными — правка методики управляющей компании, той самой, по
# которой считаются отчёты партнёрам. Обе пустые — инструменты методики
# выключены целиком, и сервер отвечает только на вопросы о проверках.
#
# Правка не переписывает действующий набор. Каждая правка кладёт РЯДОМ новую
# версию, движок её проверяет, и только принятую им версию можно опубликовать
# отдельным вызовом. Старые версии не удаляются никогда: по ним посчитаны
# отчёты, и отчёт годичной давности обязан оставаться объяснимым (D050).

# Каталог хранилища версий. Внутри: versions/<версия> — снимки методики,
# current — указатель на действующую, journal.jsonl — журнал правок.
# Каталог не в git: методика — данные управляющей компании (D002).
MCP_CHECKLIST_STORE=

# Кому методика открыта — и на чтение версий, и на правку. Коды арендаторов
# через запятую или с новой строки, ровно те же, что слева от «=» в
# MCP_TOKENS. Методика одна на всю сеть, и правит её управляющая компания:
# токен партнёра открывает его проверки, но не её. Названный здесь арендатор,
# которого нет среди токенов, — отказ на старте: опечатка иначе выглядела бы
# работающей настройкой.
MCP_CHECKLIST_TENANTS=

# Боевая методика берётся из AUDIT_DATA_DIR — того же каталога, из которого
# читает движок. Своей переменной у сервера нет намеренно: второй путь к одной
# методике разошёлся бы с первым, и агент правил бы не то, по чему считается
# оценка. С этого каталога начинается хранилище версий.
#
# ЧТОБЫ ПУБЛИКАЦИЯ РАБОТАЛА, AUDIT_DATA_DIR обязан указывать на сам указатель
# хранилища (MCP_CHECKLIST_STORE/current) — публикация переставляет его.
# Пока AUDIT_DATA_DIR смотрит в обычный каталог методики, версии заводятся и
# проверяются, а публикация получает отказ: молча «опубликовать» то, чего
# движок не увидит, хуже, чем не опубликовать вовсе.
#
# Порядок настройки, один раз:
#   1) AUDIT_DATA_DIR=/путь/к/data, MCP_CHECKLIST_STORE=/путь/к/checklist-store
#   2) любой вызов инструмента методики заводит хранилище снимком из data
#   3) переставить AUDIT_DATA_DIR на /путь/к/checklist-store/current

# --- хранилище кадров (задача T094, решения D004 и D054) ---------------------
#
# Идентификатор кадра в телеграме снаружи не открывается и живёт ровно столько,
# сколько живёт бот с этим токеном: в базе он мёртвая ссылка на доказательство.
# Поэтому при завершении проверки кадры уезжают в S3-совместимое хранилище.
# Имена переменных S3-совместимые и поставщика не называют: смена хранилища
# (Supabase Storage, AWS, что угодно ещё) — правка значений, не кода.

# Корзина, куда ложатся кадры. Продукт её не создаёт: в настоящем хранилище
# таких прав у него нет и быть не должно — корзина заводится заранее.
S3_BUCKET=inspection-frames

# Ключи доступа. В git не попадают никогда, только сюда, в .env.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Адрес хранилища. ПУСТО — это настоящий AWS S3, и только он: подставлять сюда
# что-то по умолчанию нельзя, иначе кадры уедут не туда, куда думал
# запускающий, и молча. Для локального стенда (профиль `storage`) —
# http://127.0.0.1:9090 с хоста или http://storage:9090 изнутри контейнера бота.
S3_ENDPOINT_URL=

# Регион. У S3-совместимых серверов формальность, но без него не собирается
# подпись запроса. Пусто — us-east-1.
S3_REGION=

# Порт локального стенда хранилища на хосте (профиль `storage`). Наружу не
# смотрит — только на петлю. Стенд нужен для смоука: тома у него нет, данные не
# переживают пересоздание контейнера. Боевое хранилище задаётся S3_* выше.
S3_STAND_PORT=9090

# polling — разработка и работа без публичного адреса; webhook — когда адрес появится.
BOT_MODE=polling

# Язык, на котором бот говорит ДО начала проверки: приветствие и мастер начала
# (задача T131). Начатая проверка дальше говорит своим языком — тем, который
# аудитор выбрал в мастере, — и эту переменную уже не слушает.
#
# Пусто — русский, как боевой бот работает с первого дня. Известные значения:
# ru, en (третий добавляется строками в src/bot/texts.py, а не сюда).
# Неизвестное значение — отказ на старте: молча стать русским бот не имеет
# права, иначе опечатка обнаружится на показе заказчику.
#
# Демо-стенду эту переменную задавать не нужно: профиль `demo` в
# docker-compose.yml ставит себе `en` сам. Демо обязано быть английским
# целиком, и это свойство демо, а не настройка запускающего.
BOT_UI_LANG=

# Часовой пояс: в контейнере по умолчанию UTC, и даты в отчёте уедут.
TZ=Europe/Belgrade

# Ниже — настройки разбора (блок recognize). Все необязательны: без них
# берутся значения по умолчанию из src/recognize/config.py, здесь — те же
# значения, чтобы .env.example был честной шпаргалкой, а не пустыми именами.

# Модель разбора комментария и фото. Флагман — решение D013, цена ошибки
# (неверный отчёт партнёру) несопоставима с разницей в 93 цента на проверку.
RECOGNIZE_MODEL=gpt-5.6-sol

# Модель транскрипции голосовых (решение D008).
RECOGNIZE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Таймаут одного вызова модели, секунд.
RECOGNIZE_TIMEOUT=90

# Порог уверенности: ниже — кандидат показывается, но помечается «нужен человек».
RECOGNIZE_MIN_CONFIDENCE=0.6

# Максимум кандидатов кнопками: больше пяти аудитор на телефоне не разберёт.
RECOGNIZE_MAX_CANDIDATES=5

# Путь к бинарнику ffmpeg (перекодировка голосовых, решение D008). В образе
# `Dockerfile` ffmpeg стоит системно и виден по имени — оставить как есть.
FFMPEG_BIN=ffmpeg
