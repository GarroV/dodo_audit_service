# Белый список vulture: имена, которые используются, но не видны статически.
# Формат канонический (`vulture --make-whitelist`): голое имя считается чтением.
# Причина обязательна на каждую группу — список без причин через месяц
# превращается в глушилку проверки, а не в её настройку.
# Подключается через `paths` в pyproject.toml.

# Хендлеры aiogram: по имени их не зовёт никто, вызывает диспетчер по фильтрам,
# а регистрирует декоратор `@router.message(...)`. Поимённо, а не маской `on_*`:
# маска спрятала бы и настоящий мёртвый хендлер, забытый после правки сценария.
on_start
on_new
on_resume_continue
on_resume_new
on_unit
on_unit_not_text
on_kind
on_lang
on_photo
on_comment

# Вторая очередь: разбор по кнопке, правки записи, завершение проверки.
# Те же хендлеры aiogram, только их больше — весь диалог после кадра собран на
# нажатиях, и статически ни одно из этих имён не читается.
on_analyze
on_pick
on_zone_for_pick
on_zone_for_manual
on_manual
on_manual_page
on_manual_pick
on_manual_level
on_skip
on_undo
on_edit
on_zone
on_level
on_new_text
on_anything_else
on_finish
on_build
on_build_without_photos
on_resume

# Оснастка тестов реализует абстрактный `BaseSession` из aiogram: имена методов
# и их параметры заданы базовым классом, убрать неиспользуемый параметр нельзя —
# оснастка перестанет подходить под интерфейс, ради которого написана.
_.make_request
_.stream_content
url
headers
timeout
chunk_size
raise_for_status

# MCP-сервер (T095): крючки http.server, которые фреймворк ищет ПО ИМЕНИ, а
# код по имени не зовёт. `do_GET`/`do_POST` вызывает базовый обработчик по
# методу запроса; `log_message` он же зовёт на каждую строку лога;
# `server_version`/`sys_version` подставляются им в заголовок ответа;
# `daemon_threads` читает ThreadingHTTPServer при запуске потока;
# `close_connection` читает он же после ответа, чтобы закрыть соединение.
do_GET
do_POST
log_message
server_version
sys_version
daemon_threads
close_connection
