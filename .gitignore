# Секреты
.env
.env.*
!.env.example

# Чувствительное: методика УК и боевые проверки партнёров. Здесь же в рабочие
# копии блоков подкладываются данные (копией или симлинком) — правило закрывает
# и то, и другое, поэтому отдельного блока про симлинки ниже больше нет.
# Файлы остаются локально как референс и эталон регресса, но в публичный репозиторий не уходят.
#
# Ведущая косая обязательна. Без неё `data/` совпадает с ЛЮБЫМ каталогом `data`
# на любой глубине: так молча пропал весь синтетический набор `demo/data/`
# (задача T074) — файлы лежали на диске у автора, в индекс не попали ни одним
# коммитом, и приёмка этого не увидела. Правило про чувствительные данные
# обязано указывать на конкретные два каталога, а не на имя.
/data/
/examples/

# Питон
__pycache__/
*.pyc
.venv/
venv/

# Состояние проверок
inspection.json
checklist_data/
secret.env
.venv

# Артефакты прогона
.coverage
# Файлы данных покрытия подпроцессов движка (make cov-engine, T037)
.coverage.*
reports/

# Артефакты установки пакета
*.egg-info/

# Демо-состояние: результат идемпотентного сида, в git не хранится
demo/state/
