# Отдельная конфигурация: покрытие движка, который вызывается подпроцессом
# (задача T037). Держится отдельно от основной метрики намеренно — порог
# приёмки в проекте относительный, и подмешивание движка в общий процент
# сдвинуло бы базу так, что её нельзя было бы сравнивать с прошлыми числами.
[run]
# Путь АБСОЛЮТНЫЙ через подстановку, и это не украшательство (T037).
# `source = engine` резолвится от рабочего каталога ПРОЦЕССА, а движок
# запускается из папки проверки (`examples/belgrade-1`, временные каталоги
# тестов) — там каталога `engine` нет, source не совпадает ни с чем, и
# подпроцесс пишет пустой файл данных. Ровно поэтому `coverage combine`
# склеивал один файл из 66 и печатал 0%: остальные были пусты, а пустые он
# молча пропускает. Проверено прямым запуском: с относительным путём в файле
# 0 записей, с абсолютным — 3 файла движка и данные на месте.
# `COVERAGE_ENGINE_ROOT` задаёт `make cov-engine`.
source = ${COVERAGE_ENGINE_ROOT}/engine
parallel = true
sigterm = true

[paths]
source =
    engine
    */engine
